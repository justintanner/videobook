{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/main.tsx",
    "vite.config.ts",
    "eslint.config.js",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "server/src/index.ts",
    "server/src/cli.ts",
    "server/src/test-client.ts",
    "server/src/**/*.test.ts",
    "server/scripts/**/*.ts",
    "scripts/**/*.{mjs,ts}",
    "server/src/remotion/index.tsx",
    "extension/vite.config.ts",
    "extension/src/background.ts",
    "extension/src/x-post-content.ts",
    "extension/src/**/*.test.ts"
  ],
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "server/dist/**",
    "dist-extension/**"
  ],
  "ignoreBinaries": [
    "tsx"
  ]
}
