{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "op"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "scripts/**/*.{mjs,ts}",
        "extension/src/background.ts",
        "extension/src/x-post-content.ts",
        "extension/src/**/*.test.ts"
      ]
    },
    "server": {
      "entry": [
        "src/test-client.ts",
        "src/**/*.test.ts",
        "scripts/**/*.ts",
        "src/remotion/index.tsx"
      ]
    }
  }
}
