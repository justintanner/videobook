{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreBinaries": [
    "op"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "vitest.goal-live.config.ts",
        "scripts/**/*.{mjs,ts}",
        "extension/src/background.ts",
        "extension/src/x-post-content.ts",
        "extension/src/**/*.test.ts"
      ]
    },
    "server": {
      "entry": [
        "src/test-client.ts",
        "src/**/*.test.ts",
        "scripts/**/*.ts",
        "src/remotion/index.tsx",
        "src/rhythm/worker.ts",
        "src/quiet-probes/**"
      ]
    }
  }
}
