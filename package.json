{
  "name": "videobook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,server \"wait-on tcp:127.0.0.1:3001 && vite --force\" \"npm run dev:server\"",
    "dev:local": "concurrently -n client,server \"wait-on tcp:127.0.0.1:3001 && vite --force\" \"tsx watch --exclude='**/node_modules/**' --exclude='**/dist/**' server/src/index.ts\"",
    "dev:client": "vite --force",
    "dev:server": "op run --env-file=.env.tpl -- tsx watch --exclude='**/node_modules/**' --exclude='**/dist/**' server/src/index.ts",
    "start:server": "node server/dist/index.js",
    "start:client": "vite preview --host 127.0.0.1",
    "build": "npm run lint && tsc -b && vite build && npm run check:client-bundle",
    "build:extension": "vite build --config extension/vite.config.ts",
    "build:server": "cd server && tsc && cp -r src/guides dist/guides && cp -R src/remotion/public dist/remotion/",
    "lint": "eslint . --max-warnings 0",
    "typecheck:test": "tsc -p tsconfig.vitest.json --noEmit && tsc -p tsconfig.v2-test.json --noEmit && tsc -p tsconfig.v2-e2e.json --noEmit && tsc -p server/tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "use": "op run --env-file=.env.tpl -- tsx server/src/cli.ts",
    "check:op": "op run --env-file=.env.tpl -- tsx scripts/check-op.ts",
    "check:client-bundle": "tsx scripts/check-client-bundle-size.ts",
    "check:dead-code": "knip --include files,exports,types,dependencies,devDependencies,optionalPeerDependencies,unlisted,unresolved,binaries",
    "docs:commands": "tsx scripts/generate-command-docs.ts",
    "seed:dancing": "tsx scripts/seed-dancing.ts",
    "seed:multyculty": "tsx scripts/seed-multyculty.ts",
    "benchmark:search": "tsx scripts/run-search-benchmark.ts",
    "prepare:search-models": "tsx scripts/prepare-search-models.ts",
    "benchmark:startup": "tsx scripts/benchmark-startup.ts",
    "extract:videocity-benchmark": "node tools/extract-videocity-benchmark.mjs",
    "install:acestep": "tsx scripts/install-acestep.ts",
    "mint:x-token": "op run --no-masking --env-file=.env.tpl -- node scripts/mint-x-token.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --exclude=server/src/jobs/smooth-scene-concat.test.ts --exclude=server/src/tools/smooth-scene-concat.test.ts && vitest run --maxWorkers=1 server/src/jobs/smooth-scene-concat.test.ts server/src/tools/smooth-scene-concat.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:clean-install": "node tools/clean-install-smoke.mjs",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:voice:live": "VIDEOBOOK_RUN_VOICE_LIVE=1 vitest run --config vitest.voice.config.ts",
    "test:image-edit:live": "vitest run --config vitest.image-edit-live.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apicity/alibaba": "^0.14.2",
    "@apicity/b2": "^0.14.2",
    "@apicity/cost": "^0.14.2",
    "@apicity/elevenlabs": "^0.14.2",
    "@apicity/fal": "^0.14.2",
    "@apicity/free-media-upload": "^0.14.2",
    "@apicity/googleflow": "^0.14.2",
    "@apicity/kie": "^0.14.2",
    "@apicity/kimicoding": "^0.14.2",
    "@apicity/openai": "file:vendor/apicity-openai-0.14.2-34732ac.tgz",
    "@apicity/x": "file:vendor/apicity-x-0.14.2-25cff98.tgz",
    "@apicity/xai": "file:vendor/apicity-xai-0.14.2-5e561c4.tgz",
    "@modelcontextprotocol/client": "^2.2.0",
    "@remotion/bundler": "^4.0.494",
    "@remotion/google-fonts": "^4.0.467",
    "@remotion/player": "4.0.467",
    "@remotion/renderer": "^4.0.467",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
    "playwright": "^1.58.2",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.467",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "videobook-engine": "file:vendor/videobook-engine-5.7.0-ad8894e.tgz",
    "ws": "^8.21.0",
    "@apicity/dropbox": "file:vendor/apicity-dropbox-0.14.2-feaaf9d.tgz"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.5",
    "concurrently": {
      "shell-quote": "^1.11.0"
    },
    "@hono/node-server": "^2.0.11",
    "hono": "^4.12.31",
    "yauzl": ">=3.2.1",
    "flatted": ">=3.4.2",
    "picomatch": ">=4.0.4",
    "follow-redirects": ">=1.16.0",
    "postcss": "^8.5.23",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@dolthub/doltlite": "0.50.9",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/node": "2.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.4",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "express": "^5.2.1",
    "globals": "^16.5.0",
    "knip": "^6.11.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.4",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "@dolthub/doltlite@0.50.9": true,
    "esbuild": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.29.0": true,
    "usearch@2.26.0": true,
    "ytdlp-nodejs@3.4.5": true,
    "file:vendor/videobook-engine-5.7.0-ad8894e.tgz": false
  }
}
