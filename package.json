{
  "name": "videobook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,server \"wait-on tcp:127.0.0.1:3001 && vite --force\" \"npm run dev:server\"",
    "dev:local": "concurrently -n client,server \"wait-on tcp:127.0.0.1:3001 && vite --force\" \"VIDEOBOOK_DEV_FIXTURES=1 tsx watch --exclude='**/node_modules/**' --exclude='**/dist/**' server/src/index.ts\"",
    "dev:client": "vite --force",
    "dev:server": "VIDEOBOOK_DEV_FIXTURES=1 op run --env-file=.env.tpl -- tsx watch --exclude='**/node_modules/**' --exclude='**/dist/**' server/src/index.ts",
    "start:server": "node server/dist/index.js",
    "start:client": "vite preview --host 127.0.0.1",
    "build": "npm run lint && tsc -b && vite build",
    "build:extension": "vite build --config extension/vite.config.ts",
    "build:server": "cd server && tsc && cp -r src/guides dist/guides && cp -R src/remotion/public dist/remotion/",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "use": "op run --env-file=.env.tpl -- tsx server/src/cli.ts",
    "check:op": "op run --env-file=.env.tpl -- node -e 'const keys=[\"OPENAI_API_KEY\",\"KIE_API_KEY\",\"XAI_API_KEY\",\"X_CLIENT_ID\",\"X_CLIENT_SECRET\",\"KIMI_CODING_API_KEY\",\"FAL_API_KEY\",\"DASHSCOPE_API_KEY\",\"GOOGLE_FLOW_API_KEY\",\"ELEVENLABS_API_KEY\",\"B2_ACCESS_KEY_ID\",\"B2_SECRET_ACCESS_KEY\",\"B2_REGION\",\"B2_BUCKET\",\"B2_ENDPOINT\"]; console.log(`1Password OK - ${keys.filter((k)=>process.env[k] && !process.env[k].startsWith(\"op://\")).length} secrets resolved`)';",
    "docs:commands": "tsx scripts/generate-command-docs.ts",
    "seed:multyculty": "tsx scripts/seed-multyculty.ts",
    "benchmark:search": "tsx scripts/run-search-benchmark.ts",
    "extract:videocity-benchmark": "node tools/extract-videocity-benchmark.mjs",
    "mint:x-token": "op run --env-file=.env.tpl -- node scripts/mint-x-token.mjs",
    "test": "vitest run",
    "test:clean-install": "node tools/clean-install-smoke.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@apicity/alibaba": "^0.8.4",
    "@apicity/b2": "^0.8.4",
    "@apicity/cost": "^0.8.4",
    "@apicity/elevenlabs": "^0.8.4",
    "@apicity/fal": "^0.8.4",
    "@apicity/free-media-upload": "^0.8.4",
    "@apicity/googleflow": "^0.8.4",
    "@apicity/kie": "^0.8.4",
    "@apicity/kimicoding": "^0.8.4",
    "@apicity/openai": "^0.8.4",
    "@apicity/x": "^0.8.4",
    "@apicity/xai": "^0.8.4",
    "@remotion/bundler": "^4.0.494",
    "@remotion/google-fonts": "^4.0.467",
    "@remotion/player": "4.0.467",
    "@remotion/renderer": "^4.0.467",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.467",
    "tailwind-merge": "^3.5.0",
    "use-mcp": "^0.0.21",
    "uuid": "^14.0.0",
    "videobook-engine": "file:../videobook-engine"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "hono": "^4.12.31",
    "yauzl": ">=3.2.1",
    "flatted": ">=3.4.2",
    "picomatch": ">=4.0.4",
    "follow-redirects": ">=1.16.0",
    "postcss": "^8.5.23",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "knip": "^6.11.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.4"
  },
  "allowScripts": {
    "@dolthub/doltlite@0.11.37": true,
    "esbuild": true,
    "file:../videobook-engine": true
  }
}
