{
  "name": "clipfirst",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "cd server && tsc",
    "lint": "eslint .",
    "preview": "vite preview",
    "use": "tsx server/src/cli.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nakedapi/kie": "file:../nakedapi/packages/provider/kie",
    "@nakedapi/kimicoding": "file:../nakedapi/packages/provider/kimicoding",
    "@nakedapi/openai": "file:../nakedapi/packages/provider/openai",
    "@radix-ui/react-slot": "^1.2.4",
    "@remotion/cli": "^4.0.434",
    "@remotion/renderer": "^4.0.434",
    "class-variance-authority": "^0.7.1",
    "clipfirst-fs": "file:../clipfirst-fs",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.434",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-mcp": "^0.0.21",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
