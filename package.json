{
  "name": "videocity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server \"wait-on tcp:127.0.0.1:3001 && vite\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --exclude='**/vc-engine/**' --exclude='**/node_modules/**' --exclude='**/dist/**' server/src/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "cd server && tsc",
    "lint": "eslint .",
    "preview": "vite preview",
    "use": "tsx server/src/cli.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apicity/alibaba": "^0.2.6",
    "@apicity/cost": "^0.2.6",
    "@apicity/elevenlabs": "^0.2.6",
    "@apicity/fal": "^0.2.6",
    "@apicity/free-media-upload": "^0.2.6",
    "@apicity/kie": "^0.2.6",
    "@apicity/kimicoding": "^0.2.6",
    "@apicity/openai": "^0.2.6",
    "@apicity/x": "^0.2.6",
    "@apicity/xai": "^0.2.6",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remotion/cli": "^4.0.467",
    "@remotion/google-fonts": "^4.0.467",
    "@remotion/player": "4.0.467",
    "@remotion/renderer": "^4.0.467",
    "@wavesurfer/react": "^1.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.467",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-mcp": "^0.0.21",
    "vc-engine": "file:../vc-engine",
    "wavesurfer.js": "^7.12.1",
    "wouter": "^3.9.0"
  },
  "overrides": {
    "hono": ">=4.12.18",
    "yauzl": ">=3.2.1",
    "flatted": ">=3.4.2",
    "picomatch": ">=4.0.4",
    "follow-redirects": ">=1.16.0",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "knip": "^6.11.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.4"
  }
}
