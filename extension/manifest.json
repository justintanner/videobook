{
  "manifest_version": 3,
  "name": "Videobook Clip Downloader",
  "version": "0.1.0",
  "description": "Queue links and pages in the local Videobook server.",
  "permissions": ["activeTab", "contextMenus", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Videobook",
    "default_icon": {
      "16": "icons/videocity-16.png",
      "32": "icons/videocity-32.png",
      "48": "icons/videocity-48.png",
      "128": "icons/videocity-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-post-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/videocity-16.png",
    "32": "icons/videocity-32.png",
    "48": "icons/videocity-48.png",
    "128": "icons/videocity-128.png"
  }
}
