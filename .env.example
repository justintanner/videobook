KIMI_CODING_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
KIE_API_KEY=
FAL_API_KEY=
DASHSCOPE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_CUSTOM_VOICE_IDS=
APICITY_PAYGATE_PUBLIC_KEY_PATH=
APICITY_PAYGATE_PRIVATE_KEY_PATH=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_REGION=
B2_BUCKET=
B2_ENDPOINT=
B2_ARCHIVE_PREFIX=

# X (Twitter) — recommended setup is OAuth with auto-refresh:
#   1. Configure your X app on console.x.com (Pay-Per-Use project, Read+Write,
#      callback http://127.0.0.1:8765/callback). Load $5+ of credits.
#   2. Set X_CLIENT_ID and X_CLIENT_SECRET below.
#   3. Run: npm run mint:x-token
#      (op run needs --no-masking there, or 1Password conceals the client id
#      inside the printed authorize URL). The helper opens the authorize page,
#      then writes refreshable tokens to the application state file.
# Full guide: node_modules/@apicity/x/README.md
X_CLIENT_ID=
X_CLIENT_SECRET=

# Fallback: paste a manually-minted access token here. Note that X access
# tokens expire after ~2 hours; without OAuth refresh above, scheduled posts
# beyond that window will fail. Leave blank if using the OAuth flow.
X_ACCESS_TOKEN=

# Data home: an installed videobook keeps books/, app-state.json and .env in
# ~/.videobook; a source checkout keeps books/, runtime/app-state.json and .env
# in the repository. Set VIDEOBOOK_HOME or VIDEOBOOK_ENV_PATH in the shell, not
# here: they choose which .env file is read.
VIDEOBOOK_LIBRARY_DIR=
VIDEOBOOK_APP_STATE_PATH=
VIDEOBOOK_CATALOG_BACKUP_URL_TEMPLATE=
VIDEOBOOK_ARCHIVE_DIR=
VIDEOBOOK_OBJECT_PREFIX=superlzy-media/videobook/sha256

# 1Password (optional): any value in this file may be an op://vault/item/field
# reference, resolved with the 1Password CLI (op) when the server starts.
# VIDEOBOOK_OP_VAULT fills every still-empty variable that a vault item is named
# after (op://<vault>/<NAME>/password), not only the keys listed above. VIDEOBOOK_OP_SERVICE_TOKEN is
# env:VAR, $VAR or a literal service-account token; leave it unset to use op's
# own sign-in. `videobook setup 1password --op-vault <vault>` writes both.
# VIDEOBOOK_OP_VAULT=
# VIDEOBOOK_OP_SERVICE_TOKEN=env:OP_SERVICE_ACCOUNT_TOKEN

# Media binaries. Defaults: the bundled ffmpeg-static / @ffprobe-installer builds
# when they run on this CPU, otherwise ffmpeg / ffprobe on PATH. yt-dlp
# defaults to the copy ytdlp-nodejs downloads at install, otherwise yt-dlp on
# PATH.
# VIDEOBOOK_FFMPEG_PATH=
# VIDEOBOOK_FFPROBE_PATH=
# VIDEOBOOK_YTDLP_PATH=

# Local ACE-Step (acestep.cpp) cover-song runtime. All optional: defaults point
# at the install laid down by `npm run install:acestep`
# (~/.cache/videobook/acestep). ace-server is spawned automatically on the
# first /make-cover-song and stopped with the server.
# VIDEOBOOK_ACESTEP_SERVER_PATH=   # ace-server binary (default ~/.cache/videobook/acestep/bin/ace-server)
# VIDEOBOOK_ACESTEP_MODELS_DIR=    # GGUF model directory (default ~/.cache/videobook/acestep/models)
# VIDEOBOOK_ACESTEP_PORT=8317      # port for the spawned ace-server
# VIDEOBOOK_ACESTEP_BASE_URL=      # use an already-running ace-server instead of spawning one
# VIDEOBOOK_ACESTEP_MODEL=acestep-v15-turbo-Q4_K_M.gguf  # DiT model file name
# VIDEOBOOK_ACESTEP_KEEP_LOADED=1  # keep models resident in memory between covers
