KIMI_CODING_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
KIE_API_KEY=
FAL_API_KEY=
DASHSCOPE_API_KEY=
GOOGLE_FLOW_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_CUSTOM_VOICE_IDS=
APICITY_PAYGATE_PUBLIC_KEY_PATH=
APICITY_PAYGATE_PRIVATE_KEY_PATH=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_REGION=
B2_BUCKET=
B2_ENDPOINT=
B2_ARCHIVE_PREFIX=

# X (Twitter) — recommended setup is OAuth with auto-refresh:
#   1. Configure your X app on console.x.com (Pay-Per-Use project, Read+Write,
#      callback http://127.0.0.1:8765/callback). Load $5+ of credits.
#   2. Set X_CLIENT_ID and X_CLIENT_SECRET below.
#   3. Run: node scripts/mint-x-token.mjs
#      This writes runtime settings in the application state file.
# Full guide: node_modules/@apicity/x/README.md
X_CLIENT_ID=
X_CLIENT_SECRET=

# Fallback: paste a manually-minted access token here. Note that X access
# tokens expire after ~2 hours; without OAuth refresh above, scheduled posts
# beyond that window will fail. Leave blank if using the OAuth flow.
X_ACCESS_TOKEN=

VIDEOBOOK_LIBRARY_DIR=
VIDEOBOOK_APP_STATE_PATH=
VIDEOBOOK_CATALOG_BACKUP_URL_TEMPLATE=
VIDEOBOOK_ARCHIVE_DIR=
VIDEOBOOK_OBJECT_PREFIX=superlzy-media/videobook/sha256

# Local ACE-Step (acestep.cpp) cover-song runtime. All optional: defaults point
# at the install laid down by `npm run install:acestep`
# (~/.cache/videobook/acestep). ace-server is spawned automatically on the
# first /make-cover-song and stopped with the server.
# VIDEOBOOK_ACESTEP_SERVER_PATH=   # ace-server binary (default ~/.cache/videobook/acestep/bin/ace-server)
# VIDEOBOOK_ACESTEP_MODELS_DIR=    # GGUF model directory (default ~/.cache/videobook/acestep/models)
# VIDEOBOOK_ACESTEP_PORT=8317      # port for the spawned ace-server
# VIDEOBOOK_ACESTEP_BASE_URL=      # use an already-running ace-server instead of spawning one
# VIDEOBOOK_ACESTEP_MODEL=acestep-v15-turbo-Q4_K_M.gguf  # DiT model file name
# VIDEOBOOK_ACESTEP_KEEP_LOADED=1  # keep models resident in memory between covers
