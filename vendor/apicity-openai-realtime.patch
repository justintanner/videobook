+import { WebSocket } from "ws";
+import { OpenAiError } from "./types.js";
+export function connectOpenAiRealtime(options) {
+    if (options.signal?.aborted) {
+        return Promise.reject(new OpenAiError("Realtime connection cancelled", 499));
+    }
+    const url = new URL(options.baseURL ?? "wss://api.openai.com/v1/realtime");
+    if (options.callId)
+        url.searchParams.set("call_id", options.callId);
+    else if (options.model)
