+        const socket = new WebSocket(url, {
+            headers: { Authorization: `Bearer ${options.apiKey}` },
+            handshakeTimeout: options.timeout ?? 15_000,
+            maxPayload: 8 * 1024 * 1024,
+        });
+        let opened = false;
+        let stopped = false;
+        let resolveClosed = () => undefined;
+        const closed = new Promise((done) => {
+            resolveClosed = done;
+        });
+        const close = () => {
+            if (stopped)
+                return;
+            stopped = true;
+            socket.terminate();
+        };
+        const abort = () => {
+            reject(new OpenAiError("Realtime connection cancelled", 499));
+            close();
+        };
+        options.signal?.addEventListener("abort", abort, { once: true });
+        if (options.signal?.aborted)
+            abort();
+        socket.on("open", () => {
+            if (stopped)
+                return;
+            opened = true;
+            resolve({
+                closed,
+                close,
+                send(event) {
+                    if (stopped || socket.readyState !== WebSocket.OPEN) {
+                        throw new OpenAiError("Realtime connection is closed", 499);
+                    }
+                    socket.send(JSON.stringify(event));
+                },
+            });
+        });
+        socket.on("message", (data, binary) => {
+            if (stopped)
+                return;
+            let event;
+            try {
+                if (binary)
+                    throw new Error("Expected a JSON text event");
+                event = JSON.parse(data.toString());
+                if (typeof event !== "object" ||
+                    event === null ||
+                    !("type" in event) ||
+                    typeof event.type !== "string") {
+                    throw new Error("Missing event type");
+                }
+            }
+            catch {
+                options.onError?.(new OpenAiError("Invalid Realtime event", 502));
+                close();
+                return;
+            }
+            options.onEvent(event);
+        });
+        socket.on("error", () => {
+            const error = new OpenAiError("Realtime connection failed", 502);
+            if (!opened)
+                reject(error);
+            else if (!stopped)
+                options.onError?.(error);
+        });
+        socket.on("close", () => {
+            stopped = true;
+            options.signal?.removeEventListener("abort", abort);
+            if (!opened)
