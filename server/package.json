{
  "name": "videobook",
  "version": "0.3.3",
  "description": "Local-first MCP server and web UI for AI video creation: notebooks, generation, editing, rendering and publishing.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "notebook",
    "ai",
    "remotion",
    "ffmpeg",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/videobook",
  "type": "module",
  "bin": {
    "videobook": "bin/videobook.js"
  },
  "files": [
    "bin",
    "dist",
    "ui",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
